+      // undershot Chinese by 40%, which landed the window on the wrong wrapped line.
+      double advance = 0.0;
+      for (const char raw : text) {
+        const auto byte = static_cast<unsigned char>(raw);
+        if ((byte & 0xC0U) == 0x80U) {
