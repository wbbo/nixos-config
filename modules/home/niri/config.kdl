// ====================================================================
// Niri 配置 —— Noctalia v5 + shorin-niri 方案
// 参考: https://docs.noctalia.dev/v5/compositor-settings/niri/
// 子配置文件: binds.kdl(快捷键) / rule.kdl(窗口规则)
// ====================================================================

prefer-no-csd

// ================ 模块化子配置(参考 shorin-niri) ================
include "binds.kdl"
include "rule.kdl"
// 护眼模式: effects.kdl 是用户可写目录下的符号链接 (eye-care 脚本切换 normal/eyecare),
// 必须用绝对/家目录路径 include (store 只读目录内无法放可变链接)
include "~/.config/niri/effects.kdl"

// ================ 截图路径 ================
// niri 内置 screenshot action 的落盘位置。注意与 Mod+Shift+S / Mod+Ctrl+Shift+S
// 无关 —— 那两条走 grim|satty 管道, 保存路径由 satty 界面里决定 (binds.kdl)。
// 归入 Pictures/ 与壁纸库 (Pictures/Wallpapers) 并列; 持久化由 persist.nix 的
// "Pictures" 条目覆盖, 不需要单独的 bind 条目。
screenshot-path "~/Pictures/screenshot/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ================ 环境变量 ================
environment {
    LANG "zh_CN.UTF-8"
    LC_CTYPE "zh_CN.UTF-8"
    MOZ_ENABLE_WAYLAND "1"
    XDG_CURRENT_DESKTOP "niri:sway"
    XDG_SESSION_TYPE "wayland"
    GDK_BACKEND "wayland"
    TERMINAL "kitty"
    TERM "kitty"
    QT_QPA_PLATFORMTHEME "gtk3"
    // 输入法: 方案 3 —— GTK/SDL legacy IM module 变量不设 (Wayland 原生
    // text-input 生效, fcitx5.nix 有完整说明)。保留:
    //   QT_IM_MODULES (Qt 6.8.2+ 官方写法, 本机 Qt 6.11.1)
    //   XMODIFIERS (XWayland/wine 企业微信走 XIM, 必须)
    QT_IM_MODULES "wayland;fcitx"
    XMODIFIERS "@im=fcitx"
    GLFW_IM_MODULE "ibus"
    INPUT_METHOD "fcitx"
    QT_QPA_PLATFORM "wayland;xcb"
}

// ================ 光标 ================
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

// ================ 输出默认分辨率/缩放 (双环境自动适配) ================
// niri 按连接器名精确匹配 output 块, 未连接的块静默保留 (等待热插拔, 无副作用),
// 故同时声明 VM (Virtual-1) 与实体机内屏 (eDP-1) 两个默认块, 谁在场谁生效。
// 运行时用 `niri-res <mode>` / `niri-res scale <scale>` 修改并持久化
// (state 写入 ~/.local/state/niri-resolution|niri-scale,
//  由 spawn-at-startup 的 niri-apply-resolution 在下次启动时应用覆盖默认)。
output "Virtual-1" {
    mode "1920x1080"
    scale 1.0
}

output "eDP-1" {
    mode "1920x1080"
    scale 1.0
}

// ================ 输入设备 ================
input {
    keyboard {
        xkb { layout "us"; }
        repeat-delay 250
        repeat-rate 35
    }
    touchpad {
        tap
        // 双指轻点=右键、三指轻点=中键 —— 显式固化 libinput 默认 (LRM), 防上游默认变更
        tap-button-map "left-right-middle"
        natural-scroll
        click-method "clickfinger"
        accel-profile "adaptive"
    }
    mouse { accel-speed 0; accel-profile "flat"; }
    focus-follows-mouse max-scroll-amount="0%"
}

// ================ 概览 + 壁纸(noctalia backdrop 提供) ================
overview {
    backdrop-color "#26233a"
    workspace-shadow { off; }
    zoom 0.5
}

// ================ 启动项 ================
spawn-at-startup "noctalia"
// 应用持久化的分辨率 (若 ~/.local/state/niri-resolution 存在, 覆盖声明式默认)
spawn-at-startup "niri-apply-resolution"
// 对齐护眼状态: 修复 effects.kdl 链接 (若缺失) + 同步 wlsunset 色温
spawn-at-startup "eye-care" "--sync"
// polkit 认证代理: 已移交 Noctalia 内建 (config.toml [shell] polkit_agent=true,
// 见 noctalia.nix) —— 弹窗风格统一, 且不再跑 polkit-gnome 这个 GTK 进程。
// 注意: 整个会话只能有一个 agent, 故此处不再 spawn 任何外部认证代理
// (它负责 systemctl reboot/poweroff/suspend、udisks2 挂载、flatpak 安装等授权)。

// 剪贴板持久化守护: Wayland 剪贴板内容由"提供者进程"持有, 提供者一退内容
// 即空 (GTK4 应用如 satty/Nautilus 的复制都这样)。该守护常驻接管内容, 让
// 复制跨进程存活。--clipboard regular 只接管普通剪贴板, 不碰 primary。
spawn-at-startup "wl-clip-persist" "--clipboard" "regular"

// ================ 屏幕盖处理(laptop lid) ================
// 合盖 → 仅锁屏 (noctalia lock); logind 对合盖全设 ignore 不挂起
// (modules/nixos/services.nix HandleLidSwitch*=ignore)。
// 注意不要用 session lock-and-suspend —— 那会绕过 logind 配置直接挂起。
// 休眠入口在会话菜单 (Mod+Alt+L → sudo hibernate-now 直写内核, 见 boot.nix)。
// 开盖输入密码解锁; niri 合盖自动关内屏/开盖恢复, 无需配置。
switch-events {
    lid-close { spawn "noctalia" "msg" "session" "lock"; }
}

// ================ 模糊效果(Niri >= 26.04) ================
blur {
    passes 2
    offset 3.0
    noise 0.03
    saturation 1.0
}

// ================ 布局(参考 shorin-niri) ================
// 关键: 使用 noctalia-wallpaper layer 方案时，必须设置 transparent 背景
// 否则 niri 自带背景色会遮挡 Noctalia 的壁纸 layer
// 参考: https://docs.noctalia.dev/v5/compositor-settings/niri/
layout {
    background-color "transparent"
    gaps 10
    center-focused-column "never"
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    focus-ring {
        width 2
        active-gradient from="#88d6bbcc" to="#a8cbe2cc" angle=135
        urgent-color "#ffb4ab"
    }
    border { off; }
    shadow {
        on
        softness 20
        spread 2
        offset x=-4 y=-4
        color "rgba(0, 0, 0, 0.7)"
    }
}

// ================ 弹簧动画(参考 shorin-niri) ================
animations {
    slowdown 0.98114514
    workspace-switch         { spring damping-ratio=0.82 stiffness=400 epsilon=0.0001; }
    horizontal-view-movement { spring damping-ratio=0.84 stiffness=400 epsilon=0.0001; }
    window-open              { spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001; }
    window-close             { spring damping-ratio=0.8 stiffness=400 epsilon=0.0001; }
    window-movement          { spring damping-ratio=1.0 stiffness=800 epsilon=0.0001; }
    window-resize            { spring damping-ratio=0.9 stiffness=500 epsilon=0.0001; }
    screenshot-ui-open       { duration-ms 300; curve "ease-out-quad"; }
    overview-open-close      { spring damping-ratio=1.0 stiffness=900 epsilon=0.0001; }
}

// ================ 工作区 + 窗口/图层规则 ================
workspace "a" { }
workspace "b" { }
workspace "c" { }

// 全局窗口圆角 (Noctalia v5 推荐 20)
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// wine (Bottles) 的托盘图标窗: explorer.exe 的浮动小横条, 内容无意义且碍眼,
// 直接透明化 (托盘功能本身在 niri 下无处显示, 无损)
window-rule {
    match app-id="^explorer\\.exe$"
    opacity 0.0
}

// 全局窗口模糊
window-rule {
    background-effect {
        blur true
        xray false
    }
}

// Noctalia 设置窗口浮动
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Noctalia 面板/通知/dock/OSD/桌面组件图层背景效果 (实测 namespace 前缀:
// bar-default / notification / dock / panel / attached-panel / osd / desktop-widget-*)
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd|desktop-widget-[^\"]+)$"
    background-effect {
        xray false
    }
}

// 顶栏纯透明 + 防毛玻璃: noctalia background_opacity=0.0 (透明背景), niri blur false (无模糊)
layer-rule {
    match namespace="^noctalia-bar-default$"
    shadow { off; }
    background-effect {
        blur false
    }
}

// Noctalia 壁纸背景(backdrop layer)
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

debug { honor-xdg-activation-with-invalid-serial; }
// Firefox 固定到 workspace c 并最大化 (native app-id=firefox, flatpak=org.mozilla.firefox)
window-rule {
    match app-id=r#"^(firefox|org\.mozilla\.firefox)$"#
    open-on-workspace "c"
    open-maximized true
}

hotkey-overlay { skip-at-startup; }
