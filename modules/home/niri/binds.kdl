// 快捷键绑定 —— 参考 shorin-niri + youth 键位体系
binds {
    // -------- 程序启动(shorin-niri 风格) --------
    Mod+T              { spawn "kitty"; }
    Mod+Return         { spawn "kitty"; }
    Mod+Slash          { spawn "kitty" "--single-instance"; }
    Mod+E              { spawn "nautilus"; }
    Mod+B              { spawn "firefox"; }

    // -------- 护眼 / Scratchpad (NyxNiri 移植) --------
    Mod+Shift+N { spawn "eye-care"; }                      // 护眼模式 (暖色温 + 关模糊)
    Mod+Grave   { spawn "niri-scratch-toggle" "kitty"; }   // Scratchpad 持久浮动终端

    // -------- 窗口切换器 (niri 26.04 内置 recent-windows) --------
    // 用默认键位 Alt+Tab/Alt+Shift+Tab/Mod+Shift+Tab (Alt/Mod+grave = 同 app 窗口);
    // 此处不要绑定这些键 —— 普通 binds 优先级高于 recent-windows binds, 绑了会覆盖默认。
    // 顶栏 Scope 面板: All/Output/Workspace, 切换器内按 S 循环作用域。
    // (曾用 noctalia msg window-switcher, 已统一到 niri 原生)

    // -------- Noctalia (v5 IPC: "noctalia msg <cmd>") --------
    Mod+Space          { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S              { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma          { spawn-sh "noctalia msg settings-toggle"; }
    // 视频壁纸 picker (mpvpaper 插件面板; bar 无按钮, 快捷键唤出选视频/轮播/停止)
    Mod+W              { spawn-sh "noctalia msg panel-toggle noctalia/mpvpaper:picker"; }
    Mod+Shift+Slash    { show-hotkey-overlay; }

    // -------- 焦点移动(hjkl/方向键) --------
    Mod+H repeat=false { focus-column-left; }
    Mod+L repeat=false { focus-column-right; }
    Mod+J repeat=false { focus-window-down; }
    Mod+K repeat=false { focus-window-up; }
    Mod+Left  repeat=false { focus-column-left; }
    Mod+Right repeat=false { focus-column-right; }
    Mod+Up    repeat=false { focus-window-up; }
    Mod+Down  repeat=false { focus-window-down; }
    Mod+Tab          { focus-workspace-previous; }

    // -------- 移动窗口(Ctrl) --------
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // -------- 显示器导航 --------
    Mod+Shift+H { focus-monitor-left; }
    Mod+Shift+L { focus-monitor-right; }
    Mod+Shift+J { focus-monitor-down; }
    Mod+Shift+K { focus-monitor-up; }
    Mod+Shift+Ctrl+H { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L { move-column-to-monitor-right; }

    // -------- 列宽/窗高 --------
    Mod+R           { switch-preset-column-width; }
    Mod+Shift+R     { switch-preset-window-height; }
    Mod+Ctrl+R      { reset-window-height; }
    Mod+Ctrl+F      { expand-column-to-available-width; }
    Mod+F           { maximize-column; }
    Mod+Alt+F       { fullscreen-window; }
    Mod+C           { center-column; }
    Mod+Minus       { set-column-width "-5%"; }
    Mod+Equal       { set-column-width "+5%"; }
    Mod+Shift+Minus { set-window-height "-5%"; }
    Mod+Shift+Equal { set-window-height "+5%"; }

    // -------- 标签页 / 浮动 --------
    Mod+BracketLeft  repeat=false { consume-or-expel-window-left; }
    Mod+BracketRight repeat=false { consume-or-expel-window-right; }
    Mod+Shift+A      { consume-window-into-column; }
    Mod+Shift+D      { expel-window-from-column; }
    Mod+X            { toggle-column-tabbed-display; }
    Mod+V            { toggle-window-floating; }
    Mod+Shift+V repeat=false { switch-focus-between-floating-and-tiling; }
    Mod+N repeat=false { switch-focus-between-floating-and-tiling; }

    // -------- 工作区(绝对) --------
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // -------- 工作区(相对) --------
    Mod+U       { focus-workspace-down; }
    Mod+I       { focus-workspace-up; }
    Mod+Ctrl+U  { move-column-to-workspace-down; }
    Mod+Ctrl+I  { move-column-to-workspace-up; }
    Mod+Shift+U { move-workspace-down; }
    Mod+Shift+I { move-workspace-up; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // -------- 概览 --------
    Mod+O repeat=false { toggle-overview; }
    Mod+G repeat=false { toggle-overview; }

    // -------- 滚轮操作 --------
    Mod+WheelScrollDown  { focus-column-right; }
    Mod+WheelScrollUp    { focus-column-left; }
    Mod+Ctrl+WheelScrollDown { move-column-right; }
    Mod+Ctrl+WheelScrollUp   { move-column-left; }
    Mod+Shift+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // -------- 多媒体键 (via noctalia msg) --------
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    Mod+MouseMiddle  { close-window; }
    Mod+MouseForward { focus-window-up; }
    Mod+MouseBack    { focus-window-down; }

    // -------- 截图 --------
    // 两条都走 noctalia 内建截图 (screencopy 直连, 无外部进程依赖)。
    // 输出统一由 noctalia.nix 的 [shell.screenshot] 管: 落 ~/Pictures/screenshot/
    // + %Y-%m-%d_%H-%M-%S 命名 (区域截图自动加 -region 后缀, 便于区分来源)。
    // 区域:     Mod+Shift+S → 框选 (默认选区前先冻结画面) → 标注器 → 保存/复制
    // 冻结标注: Alt+Shift+S → 整屏原地冻结 → 原位涂画/裁剪 → 保存/复制;
    //           冻结前还可先在运行中的应用画面上 live 圈画 (演示场景, 区域模式做不到)。
    //
    // repeat=false: niri 键位默认按住会重复触发, 而 spawn-sh 型动作为每次起
    // 新进程 —— 实测同一次按键在 1 秒内产生两个 app-niri-sh-* scope, 表现为
    // "按一次弹出多个窗口"。cooldown-ms 再挡一道重复事件 (抑制期内直接忽略)。
    Mod+Shift+S      repeat=false cooldown-ms=400 { spawn-sh "noctalia msg screenshot-region"; }
    Alt+Shift+S      repeat=false cooldown-ms=400 { spawn-sh "noctalia msg screenshot-annotate"; }
    //
    // ★ 历史 (2026-09-14 收敛): 这里原有两套 grim|slurp|satty 链路 ——
    //   Mod+Shift+S (slurp 框选) 与 Mod+Ctrl+Shift+S (grim 全屏)。
    //   全屏那条先移除 (其场景被冻结标注完整覆盖); 区域这条随后也切到 noctalia,
    //   理由是 noctalia 原生已覆盖"框选 + 标注"全流程。随后 grim/slurp/satty
    //   三个包连同 satty 配置模块与其窗口规则一并移除
    //   (见 packages.nix / home/default.nix / rule.kdl)。
    //   区域截图需配合 noctalia.nix 的 annotate = true
    //   (否则框选完直接保存, 不进标注器)。
    //   失去的特性: satty 链路在进标注器**之前**就已 wl-copy, 标注中途关窗
    //   原图也不丢; noctalia 是完成时才复制。若日后需要这个抗中断特性, 可从
    //   git 历史 (fa7ceb5 之前) 找回原绑定。

    // -------- 录屏 --------
    // Mod+Alt+R 切换 (开始/停止), 全屏 + 系统声音, 编码器按机器能力自动协商
    // (NVENC → VAAPI → libx264 降级, 协商结果每次开机缓存; 见 record-toggle 脚本)。
    // 封装在 record-toggle 脚本 (modules/home/niri/default.nix): 负责进程判据、
    // SIGINT 收尾、通知反馈; 输出 ~/Videos/record/rec-<时间戳>.mkv (与 OBS 共用该目录)。
    // 注: Mod+Shift+R 已被 switch-preset-window-height 占用, 故用 Mod+Alt 系列。
    // repeat=false 对本键尤其关键: 锁在 exec 后已释放 (9>&-, 见 record-toggle),
    // 按住重复会让第二次触发落到"停止"分支 —— 表现是开机录一下就自己停了。
    Mod+Alt+R       repeat=false { spawn-sh "record-toggle"; }

    // -------- 系统 --------
    Mod+Q          { close-window; }
    Mod+Shift+E    { quit; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // -------- 会话管理 (noctalia session 面板: 锁定/注销/锁定并挂起/休眠/重启/关机) --------
    Mod+Alt+L   { spawn-sh "noctalia msg panel-toggle session"; }
    Ctrl+Alt+L  { spawn-sh "noctalia msg session lock"; }   // 直接锁屏 (不经面板)
}
